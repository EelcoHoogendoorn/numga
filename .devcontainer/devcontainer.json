{
  "name": "numga",
  "image": "mcr.microsoft.com/devcontainers/python:3.11",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-renderers"
      ]
    }
  },
  "containerEnv": {
    "PYTHONPATH": "${containerWorkspaceFolder}/rewrite"
  },
  "postCreateCommand": "pip install -e rewrite/ && pip install matplotlib scipy pytest ipykernel imageio"
}
